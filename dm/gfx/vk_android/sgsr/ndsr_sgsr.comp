// In place of a game's neural upscaler dispatch (vka_draw.c / vka_ndsr_sgsr.h, DM_VK_NDSR=4): the game's input texture scaled to its output image in one pass,
// one output pixel per invocation; the store and its variants are FSR's (../fsr/ndsr_out.h: floats into B10G11R11, or packed words through an R32_UINT view; SQ squares).
// Qualcomm's configuration: OperationMode 1 (RGBA: green leads the edge test), UseEdgeDirection on (the edge-direction weights, as in the high-quality and VR targets of
// Qualcomm's Unreal plugin), EdgeThreshold 8/255 (Qualcomm's value for mobile), EdgeSharpness 2.0 (its default). Changes from the fragment shader: the texture
// coordinate is the output pixel's centre; ViewportInfo comes in push constants; no highp on the constructors (desktop GLSL); the result is clamped below at 0 but not above at 1 (the input is a float colour
// or its square root and may exceed 1: Qualcomm's clamp suits a UNORM target and would clip highlights at edges only)
// The filter itself is in sgsr1.h (configuration, helpers) and sgsr1_body.h (main's body, included as text so this pass's SPIR-V stays as it was), shared with the
// present's fragment pass (present_sgsr.frag)
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P { vec4 ViewportInfo; uvec2 size; } pc;   // ViewportInfo: 1 / input width, 1 / input height, input width, input height
#include "../fsr/ndsr_out.h"

precision mediump float;
precision highp int;

layout(set = 0, binding = 0) uniform mediump sampler2D ps0;

#include "sgsr1.h"

void main()
{
	uvec2 p = gl_GlobalInvocationID.xy;
	if (any(greaterThanEqual(p, pc.size))) return;
	highp vec4 ViewportInfo[1]; ViewportInfo[0] = pc.ViewportInfo;
	highp vec2 in_TEXCOORD0 = (vec2(p) + 0.5) / vec2(pc.size);

#include "sgsr1_body.h"

	ndsr_store(ivec2(p), color.xyz);
}
